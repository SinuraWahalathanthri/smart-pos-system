{
  "name": "pos-system",
  "version": "2.2.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "ldd": "vitest run tests/ldd/kit.demo.test.ts --reporter=verbose",
    "mock:supabase": "node scripts/mock-supabase.mjs",
    "dev:mock": "node scripts/dev-mock.mjs",
    "db:plan": "tsx tools/db-plan.ts",
    "build:desktop": "cross-env BUILD_TARGET=desktop next build",
    "desktop": "npm run build:desktop && electron .",
    "desktop:dev": "cross-env DESKTOP_DEV=1 electron .",
    "dist": "npm run desktop:config && npm run build:desktop && electron-builder --config electron-builder.config.js",
    "dist:win": "npm run desktop:config && npm run build:desktop && electron-builder --config electron-builder.config.js --win",
    "dist:mac": "npm run desktop:config && npm run build:desktop && electron-builder --config electron-builder.config.js --mac",
    "dist:linux": "npm run desktop:config && npm run build:desktop && electron-builder --config electron-builder.config.js --linux",
    "smoke:desktop": "electron . --smoke",
    "icons": "node scripts/build-icons.mjs",
    "desktop:config": "node scripts/write-desktop-config.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "clsx": "^2.1.1",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.57.0",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "fake-indexeddb": "^6.2.5",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "main": "desktop/main.js",
  "description": "Barcode-driven point of sale for the shop: checkout, stock, purchasing and analytics.",
  "author": "Sinura Wahalathanthri"
}
